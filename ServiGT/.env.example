# Configuracion de ServiGT por ambiente (task 4.1).
#
# Copiar a `ServiGT/.env` y completar. Ese archivo NO se versiona: el
# .gitignore de este directorio lo excluye. Docker Compose lo lee
# automaticamente porque esta junto a docker-compose.yml.
#
# Ninguna de estas variables tiene valor por defecto en docker-compose.yml. Si
# falta alguna obligatoria, el contenedor falla al arrancar con un mensaje
# explicito en vez de usar una credencial conocida.

# ── Obligatorias ───────────────────────────────────────────────────────────

# Clave de cifrado de Laravel. Generar una propia por ambiente:
#   docker compose run --rm --entrypoint "php artisan key:generate --show" backend
# Nunca reutilizar la de otro ambiente ni la de un ejemplo.
APP_KEY=

# Contrasena de PostgreSQL. La usan el servicio `db` (para crearla) y el
# backend (para conectarse), asi que debe ser la misma en ambos.
DB_PASSWORD=

# Cuenta de administrador que siembra el backend en una base vacia. Minimo 12
# caracteres. El entrypoint nunca la imprime ni la registra en logs.
ADMIN_PASSWORD=

# ── Opcionales ─────────────────────────────────────────────────────────────

# local | production. Fuera de `local`, CORS deja de aceptar cualquier origen.
APP_ENV=local

# Con debug encendido una excepcion no controlada devuelve stack trace, SQL y
# rutas del servidor. Solo para depurar en la maquina propia.
APP_DEBUG=false

# URL publica del backend. Debe coincidir con el puerto expuesto.
APP_URL=http://localhost:8085

# URL del API que se incrusta en el bundle web en build-time.
PUBLIC_API_URL=http://localhost:8085/api

# Origenes autorizados para CORS, separados por comas. Vacio fuera de local
# significa que el navegador bloquea todo cross-origin.
# Ejemplo: CORS_ALLOWED_ORIGINS=https://www.servigtdev.com,http://localhost:8086
CORS_ALLOWED_ORIGINS=

ADMIN_EMAIL=admin@servigt.gt

DB_DATABASE=pservicios
DB_USERNAME=pservicios_user

# ── Datos demo ─────────────────────────────────────────────────────────────
#
# Los diez proveedores de ejemplo comparten contrasena y llevan telefonos
# ficticios: sirven para la demo del catalogo, no para un ambiente real. Se
# siembran solo con SEED_DEMO_DATA=true, y entonces PROVIDER_SEED_PASSWORD pasa
# a ser obligatoria.
SEED_DEMO_DATA=false
PROVIDER_SEED_PASSWORD=
